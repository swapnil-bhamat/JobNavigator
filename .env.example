# === Project & Environment ===
COMPOSE_PROJECT_NAME=jobnavigator-dev
JN_ENV=development

# === Database ===
POSTGRES_PASSWORD=change_me_local_dev_password
DATABASE_URL=postgresql://jobnavigator:change_me_local_dev_password@db:5432/jobnavigator

# === Dashboard Authentication ===
# Empty = no auth on first run (set a strong key before exposing on any network)
INITIAL_API_KEY=

# === Google Gemini API (Cloud AI — optional for basic startup without AI) ===
# Keep this ONLY in .env (git-ignored). Never expose to frontend.
GEMINI_API_KEY=
# Configurable model IDs (verify availability, structured JSON output, rate limits & pricing first)
GEMINI_MODEL_TRIAGE=
GEMINI_MODEL_FULL=

# === AI Cost & Budget Guard ===
AI_MONTHLY_BUDGET_INR=500
USD_TO_INR_RATE=85.0
AI_BUDGET_SAFETY_MARGIN=1.15

# === Feature Flags (Safe Defaults) ===
JN_RUNNER_MANAGEMENT=0
JN_ENABLE_GMAIL=0
JN_ENABLE_UNOFFICIAL_LINKEDIN=0
JN_TELEMETRY=off
JN_SCHEDULER_DISABLED=0

# === Concurrency Limits (HP t620 friendly) ===
MAX_CONCURRENT_SCRAPES=1
SCORING_MAX_CONCURRENT=1

# === Encrypted Backups (age public recipient key, e.g. age1...) ===
# Keep the corresponding private identity key OFF the server / separate from backups.
BACKUP_AGE_RECIPIENT=

# === Optional Notifications (Telegram) ===
TELEGRAM_BOT_TOKEN=

# === CORS Allowed Origins ===
ALLOWED_ORIGINS=http://localhost,http://localhost:8088,http://localhost:5173
